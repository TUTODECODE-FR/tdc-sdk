{
  "name": "vscode-tdc-language",
  "displayName": "TUTODECODE Script (.tdc) Language Support",
  "description": "Syntax highlighting, real-time diagnostics, autocompletion, hover docs, and 1-click open in TDC Studio.",
  "version": "1.1.0",
  "publisher": "tutodecode",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tdc"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "tdc",
        "aliases": [
          "TUTODECODE Script",
          "tdc"
        ],
        "extensions": [
          ".tdc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tdc",
        "scopeName": "source.tdc",
        "path": "./syntaxes/tdc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tdc",
        "path": "./snippets/tdc.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "tdc.openInStudio",
        "title": "Ouvrir dans TDC Studio",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tdc.openInStudio",
          "when": "resourceExtname == .tdc",
          "group": "navigation"
        }
      ]
    }
  }
}
