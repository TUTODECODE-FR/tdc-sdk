{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TUTODECODE Script",
  "patterns": [
    { "include": "#comments" },
    { "include": "#triple-strings" },
    { "include": "#strings" },
    { "include": "#custom-category" },
    { "include": "#keywords" },
    { "include": "#properties" },
    { "include": "#color-tokens" },
    { "include": "#constants" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tdc",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.tdc",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "custom-category": {
      "patterns": [
        {
          "match": "\\b(category)\\s+(custom)\\s+(\"[^\"]+\")",
          "captures": {
            "1": { "name": "keyword.control.tdc" },
            "2": { "name": "storage.type.tdc" },
            "3": { "name": "string.quoted.double.tdc" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tdc",
          "match": "\\b(course|module|quiz|question|codeblock|metadata|category|custom)\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.tdc",
          "match": "\\b(title|description|category|level|duration|icon|accent|author|author-key|signature|tdc-version|keywords|content|markdown|options|correctAnswer|explanation|label|color|executable|expectedOutput|language)\\b"
        }
      ]
    },
    "color-tokens": {
      "patterns": [
        {
          "name": "support.constant.color.tdc",
          "match": "\\b(creme|mint|lavande|ambre|coral|sky|pink|emerald|cyan|gold|linux)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.tdc",
          "match": "\\b(linux|network|security|cloud|crypto|development|beginner|intermediate|advanced|true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tdc",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tdc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tdc",
          "match": "\\\\."
        }
      ]
    },
    "triple-strings": {
      "name": "string.quoted.triple.tdc",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "markup.heading.markdown",
          "match": "^#+\\s+.*$"
        },
        {
          "name": "markup.bold.markdown",
          "match": "\\*\\*.*?\\*\\*"
        },
        {
          "name": "markup.italic.markdown",
          "match": "\\*.*?\\*"
        },
        {
          "name": "markup.raw.block.markdown",
          "match": "```[\\s\\S]*?```"
        }
      ]
    }
  },
  "scopeName": "source.tdc"
}
